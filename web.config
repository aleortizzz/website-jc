<?xml version="1.0" encoding="UTF-8"?>
<!--
  Config de IIS (servidor Windows / Ferozo). Reemplaza al .htaccess (Windows no lo usa).
  Módulo "URL Rewrite" confirmado instalado en el servidor.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <!-- IIS no sirve extensiones desconocidas por defecto. Los parciales header/footer
           son .inc y se cargan por fetch() desde include.js -> hay que mapearlos. -->
      <remove fileExtension=".inc" />
      <mimeMap fileExtension=".inc" mimeType="text/html" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <rewrite>
      <rules>

        <!-- Bloquear archivos internos que quedan en el server -->
        <rule name="Bloquear internos" stopProcessing="true">
          <match url="(^|/)(\.ftp-deploy-sync-state\.json|web\.config)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Forzar HTTPS (contempla SSL terminado upstream via X-Forwarded-Proto para no hacer loop) -->
        <rule name="Forzar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^off$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://jcbarandas.com.ar/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Dominio canonico: cualquier host que no sea jcbarandas.com.ar (jcherrajes.*, www, .com, dominio temporal) -> jcbarandas.com.ar -->
        <rule name="Dominio canonico" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^jcbarandas\.com\.ar$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://jcbarandas.com.ar/{R:1}" redirectType="Permanent" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
