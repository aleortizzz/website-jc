<?xml version="1.0" encoding="UTF-8"?>
<!--
  Config de IIS (servidor Windows / Ferozo). Reemplaza al .htaccess (que en Windows no funciona).

  ESTADO ACTUAL: mínimo y seguro (default document + caché de estáticos).
  El bloque CUTOVER de abajo (forzar HTTPS + dominio canónico + bloquear archivos internos)
  se descomenta al pasar a jcbarandas.com.ar con el SSL ya activo. Requiere el módulo
  "URL Rewrite" de IIS — si al descomentarlo el sitio tira error 500, es que no está
  instalado en el plan y hay que pedirlo a soporte de DonWeb.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <!-- IIS no sirve extensiones desconocidas por defecto. Los parciales header/footer
           son .inc y se cargan por fetch() desde include.js -> hay que mapearlos. -->
      <remove fileExtension=".inc" />
      <mimeMap fileExtension=".inc" mimeType="text/html" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- PRUEBA: chequear si el módulo URL Rewrite está instalado.
         Si el sitio sigue cargando normal -> el módulo está (borrar este bloque y poner la Parte B real).
         Si el sitio tira error 500 -> el módulo NO está (revertir este commit y pedirlo a soporte).
         Test: abrir https://jcbarandas.com.ar/__rewrite-ok -> debe redirigir a la home. -->
    <rewrite>
      <rules>
        <rule name="urlrewrite-check" stopProcessing="true">
          <match url="^__rewrite-ok$" />
          <action type="Redirect" url="https://jcbarandas.com.ar/#rewrite-ok" redirectType="Found" />
        </rule>
      </rules>
    </rewrite>

    <!-- ===================== CUTOVER: descomentar al migrar a jcbarandas.com.ar =====================

    <rewrite>
      <rules>

        <rule name="Bloquear archivos internos" stopProcessing="true">
          <match url="^(\.ftp-deploy-sync-state\.json|PROYECTO\.md|notes\.txt|package(-lock)?\.json|tailwind\.config\.js|postcss\.config\.js|web\.config)$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <rule name="Forzar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://jcbarandas.com.ar/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="Dominio canonico" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^jcbarandas\.com\.ar$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://jcbarandas.com.ar/{R:1}" redirectType="Permanent" />
        </rule>

      </rules>
    </rewrite>

    ===================== fin CUTOVER ===================== -->

  </system.webServer>
</configuration>
